# Local stack examples. Copy values into process environment variables.
# Never commit real credentials or bearer tokens.
# Local Thesis uses native PostgreSQL. start-stack.ps1 creates a private password,
# writes THESIS_POSTGRES_DSN into ignored .env, and retains thesis-postgres-data.
# Azure Thesis continues to select its configured Cosmos adapter.
THESIS_PERSISTENCE=postgres
# THESIS_POSTGRES_DSN=postgresql://thesis:<password>@127.0.0.1:5433/thesis
# THESIS_TEST_POSTGRES_DSN=<dedicated disposable-test server; never application data>
#
# Loopback bearer tokens for market-lake, harness, and Thesis are minted into
# the ignored .env by scripts/local/dev_tokens.py; do not set them here.
LAKE_PROVIDER__API_KEY=
LAKE_PROVIDER__API_SECRET=
LAKE_API__BEARER_TOKEN=

# The workstation runs the complete harness with filesystem storage and finite
# local ingestion workers. No Azure access is required for local market data.
# To select the whole remote harness, configure HARNESS_MCP_URL instead.

# Optional. The default is the repository-ignored .local/market-lake directory.
# LAKE_LOCAL_DATA_DIR=.local/market-lake

# Optional. Override only when market-lake YAML config lives outside this repo.
# LAKE_CONFIG_ROOT=config/market-lake

# Optional. Harness MCP endpoint. Local and remote both use the harness HTTP
# `/mcp` endpoint: the local stack defaults to the local harness API
# (http://127.0.0.1:8001); set this to the deployed service URL for a remote
# harness. `harness mcp` stdio is retained only for tests/tools.
# HARNESS_MCP_URL=http://127.0.0.1:8001

# Reader cache budgets; zero disables the corresponding retained cache.
# HARNESS_MARKET_DATA_CACHE_DIR=.local/market-data-cache
# HARNESS_MARKET_DATA_CACHE_DISK_BYTES=4294967296
# HARNESS_MARKET_DATA_CACHE_MEMORY_BYTES=536870912
# Exact engine-ready tick blocks, shared by finite workers across repeated windows.
# Zero disables disk retention; replay still uses bounded compact blocks.
# HARNESS_PREPARED_REPLAY_DIR=.local/prepared-replay
# HARNESS_PREPARED_REPLAY_BYTES=34359738368
# Finite backtest/study/screening workers share this results backend with the API.
# HARNESS_RESULTS_ROOT=.local/harness-results
# HARNESS_RESULTS_CONTAINER=harness-results
# Terminal job events POST to Thesis; credentials stay in service configuration.
# The local launcher sets these from the stable harness bearer automatically.
# HARNESS_COMPLETION_URL=https://thesis.example/v1/internal/harness/completions
# HARNESS_COMPLETION_TOKEN=<shared-service-credential>
# HARNESS_EXECUTION_MAX_WORKERS=2
# HARNESS_WORKER_EXECUTABLE=<absolute-path-to-harness-worker>
# Azure execution uses a digest-pinned ACA Job template; retries are disabled.
# HARNESS_EXECUTION_JOB_RESOURCE_ID=/subscriptions/.../providers/Microsoft.App/jobs/<prefix>-backtest
# HARNESS_EXECUTION_IMAGE=registry.azurecr.io/fca@sha256:<64-lowercase-hex>
# Exact valuation/ledger spill capacity per history (bytes); RAM uses 8192-row frames.
# HARNESS_HISTORY_SCRATCH_BYTES=2147483648
# Optional local hosting of the Azure market-data capability; deployment injects these.
# LAKE_STORAGE_ACCOUNT_NAME=<storage-account>
# LAKE_STORAGE_CONTAINER=lake
# LAKE_COVERAGE_TABLE=coverage
# LAKE_INGEST_IMAGE=registry.azurecr.io/fca-ingestion@sha256:<64-lowercase-hex>
# AZURE_SUBSCRIPTION_ID=<subscription>
# LAKE_INGEST_RESOURCE_GROUP=<resource-group>
# LAKE_INGEST_JOB_NAME=<quant-api-name>-ingest
# LAKE_INGEST_WORKER_CLIENT_ID=<worker-identity-client-id>
# LAKE_PROVIDER_KEY_VAULT_URL=https://your-vault.vault.azure.net/
# LAKE_INGEST_CPU=4
# LAKE_INGEST_MEMORY_GIB=8
# LAKE_INGEST_MAX_WORKERS=8
# LAKE_INGEST_PARTITION_DAYS=31
# LAKE_INGEST_TIMEOUT_SECONDS=86400

# Complete harness deployment: workstation uses local; Azure deployment sets azure.
HARNESS_MARKET_DATA_MODE=local
# LAKE_LOCAL_WORKER_EXECUTABLE=<absolute-path-to-lake-ingest-worker>
# LAKE_LOCAL_PROVIDER_ENV=<absolute-path-to-ignored-provider-env-file>
# Public combined market-data base for a forwarded port or LAN hostname.
# LAKE_LOCAL_PUBLIC_URL=http://127.0.0.1:8001/market-data

# Concurrent complete sessions per ingestion worker; provider pages remain concurrent.
# LAKE_INGEST_SESSION_CONCURRENCY=2
# Local and Azure ingestion must not run simultaneously with the same Alpaca allowance.

# Thesis model context: complete history since a durable compaction checkpoint.
# Default serving model: deepseek/deepseek-v4.1-flash (1,000,000 tokens).
# Other configured models default to a conservative 128,000-token window;
# set the actual supported input/context capacity when switching models.
# THESIS_CONTEXT_WINDOW_TOKENS=1000000
# THESIS_MAX_OUTPUT_TOKENS=131072
# Default output cap for other models: 32768. This includes reasoning.
# Optional Jev verbatim-evidence ranking alongside same-model summaries.
# Without a key, compaction uses the summary and complete recent history.
# TYPESAFE_API_KEY=
