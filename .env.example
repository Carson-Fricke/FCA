# Local market-lake example only. Copy values into process environment variables.
# Never commit real credentials or bearer tokens.
LAKE_PROVIDER__API_KEY=
LAKE_PROVIDER__API_SECRET=
LAKE_API__BEARER_TOKEN=

# Optional. The default is the repository-ignored .local/market-lake directory.
# LAKE_LOCAL_DATA_DIR=.local/market-lake

# Optional. Override only when market-lake YAML config lives outside this repo.
# LAKE_CONFIG_ROOT=config/market-lake
