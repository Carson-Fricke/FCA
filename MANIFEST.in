# Source distribution payload for the Rust PyO3 bridge. The pure-Python
# packages are discovered by setuptools; the Rust workspace and the setup.py
# that builds its cdylib must travel with the sdist so a wheel can be rebuilt
# from it.
include setup.py
include src/harness/rust/Cargo.toml
include src/harness/rust/Cargo.lock
include src/harness/rust/rust-toolchain.toml
recursive-include src/harness/rust/crates *.rs
recursive-include src/harness/rust/crates Cargo.toml
