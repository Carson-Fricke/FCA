FROM ghcr.io/astral-sh/uv:0.12.6 AS uv

FROM python:3.12-slim AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR /build

COPY --from=uv /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project

COPY src/ ./src/
RUN uv sync --locked --no-dev --no-editable
COPY scripts/ci/installed_sdk_smoke.py /tmp/installed_sdk_smoke.py
RUN uv run --no-sync python -I /tmp/installed_sdk_smoke.py
RUN test -x /opt/venv/bin/thesis

FROM python:3.12-slim AS runtime

ENV PATH="/opt/venv/bin:$PATH" \
    THESIS_CONFIG_ROOT=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONFAULTHANDLER=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install --no-install-recommends -y git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 10001 thesis \
    && useradd --uid 10001 --gid thesis --create-home --shell /usr/sbin/nologin thesis

COPY --from=builder /opt/venv /opt/venv
COPY config/thesis/ /app/config/thesis/

WORKDIR /app
USER thesis

ENTRYPOINT ["thesis"]
CMD ["--help"]
